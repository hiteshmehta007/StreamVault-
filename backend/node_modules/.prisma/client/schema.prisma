// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  username             String    @unique
  displayName          String?
  avatar               String?
  bio                  String?
  website              String?
  location             String?
  isVerified           Boolean   @default(false)
  isCreator            Boolean   @default(false)
  passwordHash         String
  emailVerified        Boolean   @default(false)
  emailVerifyToken     String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  // Creator Analytics
  subscriberCount Int @default(0)
  totalViews      Int @default(0)
  totalLikes      Int @default(0)
  videoCount      Int @default(0)

  // User Preferences
  privacy     Privacy @default(PUBLIC)
  preferences Json    @default("{}")

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  videos        Video[]
  channels      Channel[]
  playlists     Playlist[]
  comments      Comment[]
  likes         Like[]
  subscriptions Subscription[]  @relation("UserSubscriptions")
  subscribers   Subscription[]  @relation("UserSubscribers")
  watchHistory  WatchHistory[]
  watchLater    WatchLater[]
  notifications Notification[]
  reports       Report[]
  liveStreams   LiveStream[]
  analytics     UserAnalytics[]
  devices       Device[]

  @@map("users")
}

model Channel {
  id             String  @id @default(cuid())
  name           String
  handle         String  @unique
  description    String?
  profilePicture String?
  bannerImage    String?

  // Channel Stats
  subscriberCount Int @default(0)
  totalViews      Int @default(0)
  totalVideos     Int @default(0)

  // Channel Settings
  isVerified Boolean @default(false)
  category   String?
  country    String?
  language   String  @default("en")

  // Monetization
  monetizationEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownerId String
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  videos  Video[]

  @@map("channels")
}

model Video {
  id               String  @id @default(cuid())
  title            String
  description      String?
  thumbnail        String?
  videoUrl         String?
  duration         Int? // in seconds
  fileSize         Int? // in bytes
  originalFilename String?

  // Video metadata
  resolution  String? // "1080p", "720p", etc.
  fps         Int?
  codec       String?
  bitrate     Int?
  aspectRatio String?

  // Processing status
  status             VideoStatus @default(PROCESSING)
  processingProgress Int         @default(0)
  processingError    String?
  processingJobId    String?

  // Content details
  category String?
  tags     String[]
  language String   @default("en")

  // Visibility & Permissions
  visibility      Visibility @default(PUBLIC)
  isListed        Boolean    @default(true)
  isMatureContent Boolean    @default(false)
  allowComments   Boolean    @default(true)
  allowLikes      Boolean    @default(true)
  allowDownload   Boolean    @default(false)

  // Analytics
  viewCount    Int @default(0)
  likeCount    Int @default(0)
  dislikeCount Int @default(0)
  commentCount Int @default(0)
  shareCount   Int @default(0)

  // SEO
  slug            String? @unique
  metaTitle       String?
  metaDescription String?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  scheduledAt DateTime?

  // Relations
  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  comments        Comment[]
  likes           Like[]
  watchHistory    WatchHistory[]
  watchLater      WatchLater[]
  playlistItems   PlaylistItem[]
  reports         Report[]
  analytics       VideoAnalytics[]
  qualityVersions VideoQuality[]

  @@index([creatorId])
  @@index([channelId])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
  @@index([publishedAt])
  @@map("videos")
}

model VideoQuality {
  id       String @id @default(cuid())
  videoId  String
  quality  String // "2160p", "1440p", "1080p", "720p", "480p", "360p"
  url      String
  fileSize Int
  bitrate  Int

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, quality])
  @@map("video_qualities")
}

model Playlist {
  id          String  @id @default(cuid())
  title       String
  description String?
  thumbnail   String?

  // Visibility
  visibility Visibility @default(PUBLIC)

  // Analytics
  viewCount Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  creatorId  String
  creator    User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  items      PlaylistItem[]
  watchLater WatchLater[]

  @@index([creatorId])
  @@index([visibility])
  @@map("playlists")
}

model PlaylistItem {
  id         String @id @default(cuid())
  playlistId String
  videoId    String
  position   Int

  createdAt DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@unique([playlistId, position])
  @@map("playlist_items")
}

model Comment {
  id       String  @id @default(cuid())
  content  String
  videoId  String
  authorId String
  parentId String? // for replies

  // Status
  isEdited Boolean @default(false)
  isPinned Boolean @default(false)

  // Analytics
  likeCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  video   Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")
  likes   Like[]

  @@index([videoId])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  videoId   String?
  commentId String?
  type      LikeType @default(LIKE)

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video   Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@unique([userId, commentId])
  @@map("likes")
}

model Subscription {
  id           String @id @default(cuid())
  subscriberId String
  channelId    String

  // Notification preferences
  notifications Boolean @default(true)

  createdAt DateTime @default(now())

  subscriber User @relation("UserSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  channel    User @relation("UserSubscribers", fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, channelId])
  @@map("subscriptions")
}

model WatchHistory {
  id        String  @id @default(cuid())
  userId    String
  videoId   String
  watchTime Int // seconds watched
  completed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("watch_history")
}

model WatchLater {
  id         String  @id @default(cuid())
  userId     String
  videoId    String?
  playlistId String?

  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video    Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  playlist Playlist? @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@unique([userId, playlistId])
  @@map("watch_later")
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  title   String
  message String
  data    Json?

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  videoId     String?
  reason      ReportType
  description String?
  status      ReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  video    Video? @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model LiveStream {
  id          String  @id @default(cuid())
  title       String
  description String?
  streamKey   String  @unique
  streamUrl   String?

  status      StreamStatus @default(OFFLINE)
  viewerCount Int          @default(0)

  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  streamerId String
  streamer   User   @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("live_streams")
}

model VideoAnalytics {
  id      String   @id @default(cuid())
  videoId String
  date    DateTime @default(now())

  // Daily metrics
  views     Int @default(0)
  likes     Int @default(0)
  dislikes  Int @default(0)
  comments  Int @default(0)
  shares    Int @default(0)
  watchTime Int @default(0) // total seconds watched

  // Traffic sources
  directViews    Int @default(0)
  searchViews    Int @default(0)
  suggestedViews Int @default(0)
  externalViews  Int @default(0)

  // Demographics
  mobileViews  Int @default(0)
  desktopViews Int @default(0)
  tabletViews  Int @default(0)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, date])
  @@map("video_analytics")
}

model UserAnalytics {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @default(now())

  // Daily metrics
  profileViews Int   @default(0)
  videoViews   Int   @default(0)
  subscribers  Int   @default(0)
  watchTime    Int   @default(0)
  revenue      Float @default(0.0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("user_analytics")
}

model Device {
  id         String  @id @default(cuid())
  userId     String
  deviceId   String
  deviceType String // "mobile", "desktop", "tablet"
  platform   String // "ios", "android", "web"
  pushToken  String?
  isActive   Boolean @default(true)

  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("devices")
}

// Enums
enum Privacy {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
  MEMBERS_ONLY
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum LikeType {
  LIKE
  DISLIKE
}

enum NotificationType {
  NEW_VIDEO
  NEW_SUBSCRIBER
  NEW_COMMENT
  NEW_LIKE
  LIVE_STREAM
  SYSTEM
}

enum ReportType {
  SPAM
  INAPPROPRIATE_CONTENT
  HARASSMENT
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum StreamStatus {
  OFFLINE
  SCHEDULED
  LIVE
  ENDED
}

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/videostream"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=5000
NODE_ENV="development"

# Cloudinary (for file storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email Configuration
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"

# App Configuration
APP_NAME="Video Streaming Platform"
WEB_URL="http://localhost:3001"
MOBILE_SCHEME="videostream://"

# Mobile App Store URLs
APP_STORE_URL="https://apps.apple.com/app/your-app"
PLAY_STORE_URL="https://play.google.com/store/apps/details?id=your.app"

# File Upload
MAX_FILE_SIZE=2147483648  # 2GB in bytes
UPLOAD_PATH="./uploads"

# Logging
LOG_LEVEL="info"

# Stripe (for payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."